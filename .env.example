# OKB Media Collector — configuration template. Placeholders only: NEVER commit a real .env.
# Every platform is DISABLED by default and nothing is collected until a platform is enabled AND its allowlist
# names the exact group / sender ids to collect.

NODE_ENV=production
HOST=0.0.0.0
PORT=8090
COLLECTOR_ID=okb-media-collector
# Durable queue, staged files and audit log. Must be a persistent disk in production.
DATA_DIR=/data
LOG_LEVEL=info
# Message text in logs: only for local debugging; refused when NODE_ENV=production.
LOG_MESSAGE_CONTENT=false

# ---- Existing OKB backend (okb-bridge-cloud-backend) ----
OKB_BACKEND_URL=https://okb-bridge-api.onrender.com
# One of the backend's OKB_COLLECTOR_TOKENS (different from device and admin tokens). Min 24 characters.
OKB_COLLECTOR_TOKEN=replace-with-the-collector-token
OKB_BACKEND_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=60000

# ---- WhatsApp: OFFICIAL WhatsApp Business Platform (Cloud API) ----
WHATSAPP_ENABLED=false
# Only "official" exists. No unofficial / WhatsApp Web adapter is included.
WHATSAPP_MODE=official
# Graph API version your Meta app uses, e.g. v23.0 (required; no default is assumed).
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret: verifies X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Your own random string (min 16 chars) entered in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Groups created with the Cloud API Groups API (Official Business Account, max 8 participants).
# Comma separated: "groupId" or "groupId|Display name".
WHATSAPP_ALLOWED_GROUP_IDS=
# Reporters who message the OKB business number 1:1 (wa_id = phone number in international format, no +).
WHATSAPP_ALLOWED_SENDER_IDS=
# Hosts media may be downloaded from (Meta's lookaside CDN).
WHATSAPP_MEDIA_HOSTS=fbsbx.com,whatsapp.net

# ---- Viber: OFFICIAL REST Bot API (1:1 conversations with the OKB bot only) ----
VIBER_ENABLED=false
VIBER_MODE=official
VIBER_AUTH_TOKEN=
# Viber user ids (base64, may end with "="); "id" or "id|Display name".
VIBER_ALLOWED_SENDER_IDS=
# Accepted but not usable: the Viber Bot API cannot read groups (VIBER_MEDIA_CAPTURE_UNSUPPORTED).
VIBER_ALLOWED_GROUP_IDS=
# Hosts Viber media URLs may point to. VERIFY against a real test message before production.
VIBER_MEDIA_HOSTS=viber.com

# ---- Media limits (defaults shown) ----
MAX_IMAGE_SIZE_MB=25
MAX_DOCUMENT_SIZE_MB=50
MAX_VIDEO_SIZE_MB=200
DOWNLOAD_TIMEOUT_MS=120000
WEBHOOK_MAX_BODY_KB=1024

# ---- Queue / retries ----
QUEUE_MAX_ITEMS=2000
QUEUE_MAX_DISK_MB=4096
RETRY_MAX_ATTEMPTS=15
RETRY_BASE_DELAY_MS=5000
RETRY_MAX_DELAY_MS=1800000
WORKER_CONCURRENCY=2

# ---- Collector's own endpoints (unset = disabled) ----
# GET /metrics (Prometheus) with "Authorization: Bearer <METRICS_TOKEN>"
METRICS_TOKEN=
# POST /admin/queue/retry-failed with "Authorization: Bearer <COLLECTOR_ADMIN_TOKEN>"
COLLECTOR_ADMIN_TOKEN=
